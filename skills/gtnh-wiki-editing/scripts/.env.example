# 复制为 .env 后填写。.env 只保存在本机，不要提交到任何仓库。

# MediaWiki API 地址
BASE_URL=https://gtnh.huijiwiki.com/api.php

# 灰机 Wiki 的 API Authkey（请求头 X-authkey），向维基管理员索要
AUTHKEY=

# 个人编辑账号
EDITOR_USERNAME=
EDITOR_PASSWORD=

# 机器人账号：自行注册并获管理员授予机器人权限后填写
BOT_USERNAME=
BOT_PASSWORD=

# 本地镜像目录，默认当前目录下的 wikitext
# WIKI_DIR=wikitext

# 英文维基只读对照：不需要 Authkey 和账号，下面两项一般不用改
# EN_BASE_URL=https://wiki.gtnewhorizons.com/w/api.php
# EN_WIKI_DIR=wikitext-en
